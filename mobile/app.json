{
  "expo": {
    "name": "Serviq FM",
    "slug": "serviqfm-mobile",
    "version": "1.0.0",
    "scheme": "serviqfm",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.serviqfm.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.serviqfm.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#182848",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Serviq FM"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Serviq FM uses the camera to scan asset QR/barcodes and to take work-order and inspection photos.",
          "microphonePermission": "Serviq FM does not record audio; the camera module requests this permission on some devices.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Serviq FM accesses your photo library so you can attach existing photos to work orders and inspections."
        }
      ]
    ],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#182848"
    },
    "extra": {
      "eas": {
        "projectId": "1f2cdd5a-b7b2-4a26-bd36-70f00779e7aa"
      }
    },
    "owner": "serviqfm",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1f2cdd5a-b7b2-4a26-bd36-70f00779e7aa"
    }
  }
}
